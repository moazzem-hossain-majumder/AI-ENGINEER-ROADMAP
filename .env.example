# Environment Variables Template
# Copy this file to `.env` and insert your actual keys.
# NEVER commit your `.env` file to git or push it to public repositories!

# Groq Cloud API Key (Get free at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Get at: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (Get at: https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# OpenAI API Key (Optional - https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
